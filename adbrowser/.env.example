# Kopieren nach .env  ->  cp .env.example .env   (dann editieren)
# sudo docker compose up -d  liest diese Datei automatisch ein.

# Zugang zum Browser. Der Code wird nie an die Seiten weitergegeben und im Container nur als
# sha256 abgelegt; er schützt aber NUR vor Leuten ohne Code, nicht vor Mithören — also TLS davor.
CHAOS_ACCESS_CODE=bitte-unbedingt-aendern

# Port (muss zu ports: unten passen)
PORT=6001

# Öffentlich sichtbare URL, z.B. hinter einem Reverse Proxy
# CHAOS_PUBLIC_BASE=https://browser.example.com

# Härtere Trennung: jeder Tab bekommt <sid>.tabs.example.com (Wildcard-DNS + Wildcard-Zertifikat)
# CHAOS_ISOLATE_SUFFIX=tabs.example.com

# Eigene Werbe-Regeln persistent halten (Datei im Volume /data)
# CHAOS_DATA_DIR=/data

# Listen alle 24 h neu bauen (braucht ausgehendes HTTPS)
# CHAOS_FILTERS_AUTO_UPDATE=1

# Nur bestimmte Seiten erlauben / bestimmte sperren (Komma-getrennt)
# CHAOS_ALLOW_HOSTS=youtube.com,youtu.be,google.com
# CHAOS_DENY_HOSTS=
